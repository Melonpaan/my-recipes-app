generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model categories {
  id_category BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name        String    @unique(map: "ux_categories_name") @db.VarChar(80)
  recipes     recipes[]
}

model comments {
  id_comment BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  content    String    @db.Text
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  id_user    BigInt    @db.UnsignedBigInt
  id_recipe  BigInt    @db.UnsignedBigInt
  recipes    recipes   @relation(fields: [id_recipe], references: [id_recipe], onDelete: Cascade, map: "fk_comments_recipe")
  users      users     @relation(fields: [id_user], references: [id_user], onDelete: Cascade, map: "fk_comments_user")

  @@index([id_recipe], map: "ix_comments_recipe")
  @@index([id_user], map: "ix_comments_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ingredients {
  id_ingredient      BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  name               String               @db.VarChar(120)
  id_unit            BigInt               @db.UnsignedBigInt
  stock_qty          Decimal              @default(0.000) @db.Decimal(12, 3)
  created_at         DateTime             @default(now()) @db.Timestamp(0)
  updated_at         DateTime             @default(now()) @db.Timestamp(0)
  units              units                @relation(fields: [id_unit], references: [id_unit], map: "fk_ingredients_unit")
  recipe_ingredients recipe_ingredients[]

  @@unique([name, id_unit], map: "ux_ingredients_name_unit")
  @@index([id_unit], map: "fk_ingredients_unit")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model recipe_ingredients {
  id_recipe       BigInt      @db.UnsignedBigInt
  id_ingredient   BigInt      @db.UnsignedBigInt
  quantity_needed Decimal     @db.Decimal(12, 3)
  ingredients     ingredients @relation(fields: [id_ingredient], references: [id_ingredient], map: "fk_ri_ingredient")
  recipes         recipes     @relation(fields: [id_recipe], references: [id_recipe], onDelete: Cascade, map: "fk_ri_recipe")

  @@id([id_recipe, id_ingredient])
  @@index([id_ingredient], map: "fk_ri_ingredient")
}

model recipes {
  id_recipe          BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  title              String               @db.VarChar(160)
  description        String?              @db.Text
  prep_time          Int?                 @db.UnsignedInt
  difficulty         recipes_difficulty?
  id_category        BigInt               @db.UnsignedBigInt
  id_user            BigInt?              @db.UnsignedBigInt
  created_at         DateTime             @default(now()) @db.Timestamp(0)
  updated_at         DateTime             @default(now()) @db.Timestamp(0)
  comments           comments[]
  recipe_ingredients recipe_ingredients[]
  categories         categories           @relation(fields: [id_category], references: [id_category], map: "fk_recipes_category")
  users              users?               @relation(fields: [id_user], references: [id_user], map: "fk_recipes_user")

  @@index([id_category], map: "ix_recipes_category")
  @@index([id_user], map: "ix_recipes_user")
}

model units {
  id_unit     BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  code        String        @unique(map: "ux_units_code") @db.VarChar(16)
  name        String        @db.VarChar(64)
  ingredients ingredients[]
}

model users {
  id_user       BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  username      String     @unique(map: "ux_users_username") @db.VarChar(80)
  email         String     @unique(map: "ux_users_email") @db.VarChar(255)
  password_hash String     @db.VarChar(255)
  created_at    DateTime   @default(now()) @db.Timestamp(0)
  updated_at    DateTime   @default(now()) @db.Timestamp(0)
  comments      comments[]
  recipes       recipes[]
}

enum recipes_difficulty {
  Easy
  Medium
  Hard
}
